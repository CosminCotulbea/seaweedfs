#name of the stack
COMPOSE_PROJECT_NAME=seaweedfs

#images versions to use
NGINX_VERSION=latest
#pinned rather than latest: chrislusf/seaweedfs publishes several builds a day
SEAWEEDFS_VERSION=4.48

#size of one SeaweedFS volume in MB; every bucket gets volumes of its own, so the
#30GB upstream default fits only a handful of buckets on a small disk
SEAWEEDFS_VOLUME_SIZE_LIMIT_MB=1024

#admin UI login, change to something more secure
ADMIN_USER=admin
ADMIN_PASSWORD=password

#domain or subdomain where you want to access seaweedfs
DOMAIN_HOST=seaweedfs.dev.local
SELF_SIGNED_HOST=seaweedfs.dev.local

#nginx-proxy: redirect (default) sends http to https; noredirect answers on both.
#Locally, with SELF_SIGNED_HOST set, noredirect keeps the admin UI on https while
#applications whose PHP does not trust the self-signed CA keep using http://
HTTPS_METHOD=redirect

#email where you should receive lets encrypt renewal failures
DOMAIN_EMAIL=email@email.com

#set to production on servers to apply the docker-compose.prod.yml overrides
#any other value (or missing) runs the plain docker-compose.yml
APP_ENV=local

#what sits in front of seaweedfs-nginx (needs APP_ENV=production for host):
#   nginx-proxy - the shared nginx-proxy container (default)
#   host        - the server's own nginx; start.sh/build.sh write its vhost to HOST_CONF_PATH,
#                 get the certificate with certbot and proxy to 127.0.0.1:HOST_PORT
PROXY_MODE=nginx-proxy
HOST_PORT=
HOST_CONF_PATH=
#true also serves (and certifies) www.DOMAIN_HOST — needs a DNS record for it
HOST_WWW=false
